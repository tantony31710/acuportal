# AcuPortal — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
#
# ⚠️  Only use the ANON (public) key — never the service_role key on the frontend.

# Supabase project URL (found in: Dashboard → Project Settings → API)
VITE_SUPABASE_URL=

# Supabase anon/public key (enforces Row Level Security)
VITE_SUPABASE_ANON_KEY=
